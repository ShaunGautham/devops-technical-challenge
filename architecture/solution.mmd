flowchart TB
  subgraph INFRA["1 · Infrastructure · Terraform-defined GCP resources"]
    direction LR
    tf["Terraform<br/>infra/"] --> vpc["Custom VPC + subnet<br/>Pod and Service ranges"] --> gke["Regional GKE cluster"] --> nodes["Node pool<br/>1–2 nodes total"]
    gar["Artifact Registry"] -->|"nodes pull image"| nodes
    gke --> logs["Cloud Logging"] --> sink["Log sink"] --> bucket["GCS log bucket"]
    state["Pre-created GCS<br/>Terraform state bucket"] -. "backend" .-> tf
  end

  subgraph K8S["2 · Kubernetes · workload and traffic"]
    direction LR
    user["User"] --> lb["GKE-managed<br/>load balancer"] --> ing["Ingress<br/>route /"] --> svc["ClusterIP Service<br/>port 3000"] --> deploy["Deployment<br/>2 replicas; rolling update"] --> pods["Ready Pods"]
    hpa["HPA<br/>2–5 Pods; CPU 70%"] -. "scales" .-> deploy
    pdb["PDB<br/>minAvailable: 1"] -. "limits voluntary disruption" .-> pods
  end

